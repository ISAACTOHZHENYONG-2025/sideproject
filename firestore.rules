rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Student Food Intelligence: Public read-only access for all students (no login required)
    // Write access allowed for seeding/admin purposes during development
    match /venues/{venueId} {
      allow read: if true;
      allow write: if true; // In production, restrict write to admin or via secure Firebase Admin SDK
    }

    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}

